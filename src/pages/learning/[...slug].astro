---
import { type CollectionEntry, getCollection } from 'astro:content';
import BlogPostLayout from "../../layouts/BlogPostLayout.astro";

interface Props {
	entry: CollectionEntry<'learning'>;
}

export async function getStaticPaths() {
	const learning = await getCollection('learning');
	return learning.map((entry) => ({
		params: { slug: entry.slug },
		props: { entry },
	}));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
---

<BlogPostLayout title={entry.data.title} description={entry.data.description}>
	<div class="post article">
		<main class="post-wrapper">
			<div class="section-header">
				<div class="row">
					<div class="section-content col-1a">
						<div class="section-title">
							<div class="title-tag">
								Learning Record
							</div>
							<h1 class="title">
								{entry.data.title}
							</h1>
						</div>
					</div>
				</div>
				<div class="post-line post-line-bottom text-center">
					<span class="text-center">记录于：{entry.data.publishDate.toISOString().slice(0,10)}</span>
					{
						entry.data.read && <span class="">•</span>
						<span>{entry.data.read} min read</span>
					}
				</div>
			</div>

			<section>
				<div class="content">
					<Content />
				</div>
			</section>
		</main>
	</div>
</BlogPostLayout>

<style>
	.section-content{
		text-align:center;
	}
	.section-desc{
		text-align:center
	}
	.post-line-top{
		border-top: 1px dashed var(--color-700);
		padding-top: .5rem;
		padding-bottom: 2rem;
		margin-top: .5rem;
		font-size: .875rem;
		white-space: nowrap;
		color:var(--color-500);
		font-weight:300
	}
	.post-line-bottom{
		border-bottom: 1px dashed var(--color-700);
		padding-bottom: .5rem;
		margin:1.25rem auto 2.5rem;
		font-size: .8rem;
		white-space: nowrap;
		color:var(--color-500);
	}
	.title-tag{
		display: inline-block;
		font-size: 13px;
		line-height: 1;
		font-weight: 500;
		text-transform: uppercase;
		letter-spacing: 0.0625em;
		padding: 0.5rem 1rem;
		background: var(--color-tag-bg);
		border: 1px solid var(--color-tag-border);
		border-radius: 999rem;
		color: var(--color-500);
		margin-bottom: 1.5rem;
	}

	.title {
		font-size: 2.5rem;
		font-weight: 700;
		line-height: 1.2;
		margin: 0 0 1rem;
		color: var(--color-100);
	}

	@media (min-width: 768px) {
		.title {
			font-size: 3rem;
		}
	}

	/* 统一 Markdown 正文样式：与 blog/[...slug].astro 保持一致 */
	.content {
		position: relative;
		color: var(--color-200);
		margin: 3rem 0;
	}

	.content > :global(* + *) {
		margin-top: 1rem;
	}

	.content :global(h1),
	.content :global(h2),
	.content :global(h3),
	.content :global(h4),
	.content :global(h5) {
		margin: 1.75em 0 1em;
		color: var(--color-100);
	}
	.content :global(h2) {
		font-size: 1.75rem;
		color: var(--color-100);
	}
	.content :global(h3) {
		font-size: 1.5rem;
		color: var(--color-100);
	}
	.content :global(h4) {
		font-size: 1.25rem;
		color: var(--color-200);
	}
	.content :global(h5) {
		font-size: 1rem;
		color: var(--color-300);
	}
	.content :global(img) {
		border-radius: 8px;
	}

	.content :global(p) {
		margin: 16px 0;
		line-height: 1.8;
	}
	.content :global(ol) {
		padding-left: 2em;
		margin: 2em 0;
	}

	.article a:link {
		color: var(--color-blue);
	}
</style>
