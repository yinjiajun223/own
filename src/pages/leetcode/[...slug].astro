---
import { type CollectionEntry, getCollection } from "astro:content";
import BlogPostLayout from "../../layouts/BlogPostLayout.astro";
import Back from "../../components/Back.astro";

interface Props {
  entry: CollectionEntry<"leetcode">;
}

export async function getStaticPaths() {
  const leetcode = (await getCollection("leetcode")).filter((entry) => entry.data.solved !== false);
  return leetcode.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
---

<BlogPostLayout title={entry.data.title} description={entry.data.description}>
  <Back href="/leetcode" />
  <div class="post article">
    <main class="post-wrapper">
      <div class="section-header">
        <div class="row">
          <div class="section-content col-1a">
            <div class="section-title">
              <div class="title-tag leetcode-tag">
                LeetCode #{entry.data.problemNumber}
                {entry.data.difficulty && <span class={`difficulty-badge ${entry.data.difficulty.toLowerCase()}`}>{entry.data.difficulty}</span>}
              </div>
              <h1 class="title">
                {entry.data.title}
              </h1>
            </div>
          </div>
        </div>
        <div class="post-line post-line-bottom text-center">
          <span class="text-center">更新于：{entry.data.publishDate.toISOString().slice(0, 10)}</span>
          {
            entry.data.leetcodeUrl && (
              <>
                <span>•</span>
                <a href={entry.data.leetcodeUrl} target="_blank" rel="noopener noreferrer" class="leetcode-link">
                  在 LeetCode 上查看
                </a>
              </>
            )
          }
        </div>
      </div>

      <section class="border-top content markdown-content">
        <Content />
      </section>
    </main>
  </div>
</BlogPostLayout>

<style lang="scss">
  .leetcode-tag {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .difficulty-badge {
    padding: 0.25rem 0.75rem;
    border-radius: 0.375rem;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .difficulty-badge.easy {
    background-color: #10b981;
    color: white;
  }

  .difficulty-badge.medium {
    background-color: #f59e0b;
    color: white;
  }

  .difficulty-badge.hard {
    background-color: #ef4444;
    color: white;
  }

  .leetcode-link {
    color: var(--color-primary);
    text-decoration: none;
    transition: color 0.2s ease;

    &:hover {
      color: var(--color-primary-hover);
      text-decoration: underline;
    }
  }

  .content {
    padding: 2rem 0;
  }

  .markdown-content {
    :global(h2) {
      margin-top: 2rem;
      margin-bottom: 1rem;
      font-size: 1.75rem;
      font-weight: 600;
    }

    :global(h3) {
      margin-top: 1.5rem;
      margin-bottom: 0.75rem;
      font-size: 1.5rem;
      font-weight: 600;
    }

    :global(pre) {
      margin: 1rem 0;
      padding: 1rem;
      border-radius: 0.5rem;
      overflow-x: auto;
      background: var(--color-code-bg);
    }

    :global(code) {
      font-family: "Consolas", "Monaco", "Courier New", monospace;
      font-size: 0.875rem;
    }

    :global(p) {
      margin: 1rem 0;
      line-height: 1.75;
    }

    :global(ul),
    :global(ol) {
      margin: 1rem 0;
      padding-left: 2rem;
    }

    :global(li) {
      margin: 0.5rem 0;
      line-height: 1.75;
    }

    :global(blockquote) {
      margin: 1rem 0;
      padding-left: 1rem;
      border-left: 4px solid var(--color-primary);
      color: var(--color-text-secondary);
      font-style: italic;
    }
  }
</style>
